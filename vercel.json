{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/:path*", "has": [{ "type": "host", "value": "sayiig-urjih-myanga-(.*)\\.vercel\\.app" }], "destination": "https://sayiig-urjih-myanga.vercel.app/:path*", "permanent": false }],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
