  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run dev:frontend\"",
    "dev:frontend": "vite",
    "server": "node server/index.js",
    "dev:full": "npm run dev",
    "build": "vite build",
